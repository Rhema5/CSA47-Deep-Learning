        "\n",
        "import numpy as np\n",
        "\n",
        "X = np.array([1, 2, 3, 4, 5], dtype=float)\n",
        "y = np.array([2, 4, 6, 8, 10], dtype=float)\n",
        "\n",
        "learning_rate = 0.01\n",
        "epochs = 100\n",
        "\n",
        "def batch_gd():\n",
        "    w = 0\n",
        "    for i in range(epochs):\n",
        "        dw = np.mean((w * X - y) * X)\n",
        "        w = w - learning_rate * dw\n",
        "    return w\n",
        "\n",
        "def stochastic_gd():\n",
        "    w = 0\n",
        "    for i in range(epochs):\n",
        "        for j in range(len(X)):\n",
        "            dw = (w * X[j] - y[j]) * X[j]\n",
        "            w = w - learning_rate * dw\n",
        "    return w\n",
        "\n",
        "def mini_batch_gd():\n",
        "    w = 0\n",
        "    batch_size = 2\n",
        "\n",
        "    for i in range(epochs):\n",
        "        for j in range(0, len(X), batch_size):\n",
        "            xb = X[j:j+batch_size]\n",
        "            yb = y[j:j+batch_size]\n",
        "\n",
        "            dw = np.mean((w * xb - yb) * xb)\n",
